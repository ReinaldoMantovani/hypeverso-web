# =============================================================================
# Hypeverso Web (site público) — variáveis de ambiente
# Local: copie para .env.local. Hostinger: cadastre em hPanel › Web App ›
# Configurações › Variáveis de ambiente (e faça um novo deploy).
# =============================================================================

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço da API (projeto hypeverso-api). O navegador NUNCA fala direto com ela:
# o próprio site faz o proxy em /api/* e /uploads/* (mesma origem, cookies seguros).
# Produção: https://api.seudominio.com.br
API_INTERNAL_URL=http://localhost:4000

# Mesmo valor de GATEWAY_SHARED_SECRET do .env da API.
GATEWAY_SHARED_SECRET=troque-este-segredo-do-gateway-hypeverso-local

# Opcional: cabeçalho com o IP real do visitante. Deixe vazio na Hostinger.
# Se usar Cloudflare na frente do site: cf-connecting-ip
CLIENT_IP_HEADER=

# Opcional: atalho do escudo no topo para a equipe abrir o CMS local.
NEXT_PUBLIC_CMS_URL=

# Deixe vazio (o navegador usa o gateway same-origin /api).
NEXT_PUBLIC_API_URL=

# Google AdSense + páginas legais
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
ADS_TXT_EXTRA=
NEXT_PUBLIC_LEGAL_ENTITY=Hypeverso
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DPO_EMAIL=

# Cloudflare Turnstile (chave pública; a secreta fica na API)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CSP estrita com nonce (desative com false só para depurar)
CSP_STRICT=true

# Afiliados no catálogo de obras (botões "comprar" nas fichas)
NEXT_PUBLIC_AMAZON_TAG=
NEXT_PUBLIC_AFFILIATE_EXTRA=
